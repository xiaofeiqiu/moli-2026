# Track only the server and its supporting source/documentation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/gmsv/
!/tools/
!/docs/
!/攻略/
!/lua参考/

# Server executable, source, static game data, and configuration templates.
/gmsv/*
!/gmsv/cgmsv.exe
!/gmsv/cgmsv-gbk.cs
!/gmsv/cgmsv-gbk.exe
!/gmsv/cgmsv.cf
!/gmsv/setup.cf.example
!/gmsv/data/
!/gmsv/lua/
!/gmsv/sql/
!/gmsv/log/
/gmsv/log/*
!/gmsv/log/log.cf
/gmsv/data/err_map/
/gmsv/data/debugger.txt
/gmsv/setup.cf
/gmsv/data.db3*
/gmsv/lua/Module/question.lua
/gmsv/lua/Module/nofix/EasyGM.lua

# Supporting server tools; client display/locale tools remain local.
/tools/*
!/tools/Cleanup-CG71Tests.ps1
!/tools/cg71-pets/
!/tools/content-audit/
!/tools/five-pet/
!/tools/five-pet-probe/
!/tools/game-qol/
!/tools/game-guide/
!/tools/jobskill-pack/
!/tools/knight-gear/
!/tools/module-reload/
!/tools/npc-overlap/
!/tools/skill-library/
!/tools/sanctuary/
/tools/cg71-pets/export_previews.py
/tools/content-audit/audit_client_installer.py

# Keep written server documentation, not generated reports or process output.
/docs/**
!/docs/**/
!/docs/**/*.md
!/docs/**/README*.txt
!/docs/**/使用说明.txt

# Local dependencies, caches, databases, backups, and runtime output.
**/.deps/
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]
*.log
*.out
*.err
*.pid
*.bak
*.tmp
*.db
*.db3
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db3-wal
*.db3-shm
Thumbs.db
Desktop.ini
